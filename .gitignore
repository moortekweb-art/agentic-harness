# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
*.egg-info/
dist/
build/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
examples/shell-worker/output/
*.backup

# State / runtime artifacts
.agentic-harness/
!examples/**/.agentic-harness/
examples/**/.agentic-harness/*
!examples/**/.agentic-harness/config.yml
*.json.bak
complete.json
session.log

# OS
.DS_Store
Thumbs.db

# Secrets — never commit
.env
*.key
*.pem
*.token

# Operator-local portal data and topology inventories — these hold real
# private hostnames, never commit them. The portal reads its configuration
# from ~/.config/agentic-harness/services.json, outside any checkout; these
# rules catch stray copies. The tracked template is
# agentic_harness/gui/static/services.example.json.
*.local.json
services.local.json
services-inventory*.txt
services-inventory*.json
